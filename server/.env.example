# UmmahAPI works fully anonymously — this is optional, only raises rate limits.
UMMAHAPI_KEY=

# Required for pronunciation/Tajweed scoring (the only OpenAI call in this
# backend, and only ever on the user's own recording — never on reference
# audio). Get one at platform.openai.com, enable billing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-audio-preview
